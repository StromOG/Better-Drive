# BetterDrive v1.0.0 — Production & Local Development
#
# Copy to .env in the repo root or backend/.env. For Docker, use docker-compose.yml.
# SQLite (default): no DATABASE_URL needed — dev.db is created automatically on setup.
# For MySQL:   DATABASE_URL="mysql://user:pass@localhost:3306/betterdrive"
# For Postgres: DATABASE_URL="postgresql://user:pass@localhost:5432/betterdrive"

# ─── Backend ──────────────────────────────────────────────────────────────────
APP_PORT=4000
APP_URL=http://localhost:4000

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# 32+ char random secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-32-chars-or-longer-please!!
TOKEN_ENCRYPTION_KEY=change-me-32-chars-or-longer-please!!

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 5 GB default
MAX_UPLOAD_BYTES=5368709120

# Set to 1 to trust X-Forwarded-For (only enable behind a trusted reverse proxy)
TRUST_PROXY=0

# Google reCAPTCHA (optional — both keys required to enable captcha)
# RECAPTCHA_SECRET_KEY=

# Set to true to allow DB restore via /system/restore (requireAdmin still applies)
ALLOW_DB_RESTORE=false

# Google OAuth (seed with: npm run seed:google-config -w backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback

# Name of the root folder created in each connected Google Drive account
DRIVE_ROOT_FOLDER=BetterDrive

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Vite embeds this at build time. Leave blank for production nginx-proxied builds.
VITE_API_URL=http://localhost:4000

# Optional reCAPTCHA site key (blank = captcha UI disabled)
# VITE_RECAPTCHA_SITE_KEY=

# ─── SFTP gateway ─────────────────────────────────────────────────────────────
SFTP_ENABLED=false
SFTP_HOST=0.0.0.0
SFTP_PORT=2222
SFTP_HOST_KEY_PATH=./data/sftp_host_ed25519
SFTP_MAX_CONNECTIONS=20
SFTP_USER_MAX_SESSIONS=4
SFTP_IDLE_TIMEOUT_MS=300000
SFTP_AUTH_WINDOW_MS=60000
SFTP_AUTH_MAX_ATTEMPTS=6
# SFTP_MAX_UPLOAD_BYTES=
SFTP_SHUTDOWN_GRACE_MS=5000
SFTP_LOG_RETENTION_DAYS=30

# ─── Members & Invitations ───────────────────────────────────────────────────
INVITATION_TTL_HOURS=168

# ─── API Keys Rate Limiting ──────────────────────────────────────────────────
API_KEY_RATE_LIMIT_WINDOW_MS=60000
API_KEY_RATE_LIMIT_MAX=120

