// Better Drive — MySQL schema. SOURCE OF TRUTH for all three providers.
//
// Edit this file, then run `npm run schema:sync` from the repo root to
// regenerate the SQLite and Postgres variants:
//
//   prisma/schema.prisma           SQLite   (default, zero config)  generated
//   prisma/mysql/schema.prisma     MySQL    (this file)             edit here
//   prisma/postgres/schema.prisma  Postgres                         generated
//
// The three stay structurally identical; only the datasource block and the
// `@db.*` native type attributes differ. The attributes matter here and
// nowhere else: without `@db.Text`, MySQL would default these columns to
// VARCHAR(191) and silently truncate encrypted tokens, redirect URIs and
// JSON payloads. SQLite and Postgres need no attributes at all.
//
// Each provider keeps its own directory because Prisma resolves migrations
// as `<schema dir>/migrations`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(uuid()) @db.Char(36)
  name                 String             @db.VarChar(191)
  email                String             @unique @db.VarChar(191)
  passwordHash         String             @map("password_hash") @db.VarChar(255)
  role                 String             @default("member") @db.VarChar(32)
  status               String             @default("active") @db.VarChar(32)
  gravatarEnabled      Boolean            @default(false) @map("gravatar_enabled")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  sessions             UserSession[]
  authHandoffs         AuthHandoff[]
  providerConfigs      ProviderConfig[]
  oauthStates          OauthState[]
  connectedAccounts    ConnectedAccount[]
  s3StorageConfigs     S3StorageConfig[]
  files                File[]
  fileShares           FileShare[]
  filePreviewTokens    FilePreviewToken[]
  folders              Folder[]
  uploadSessions       UploadSession[]
  auditLogs            AuditLog[]
  savedViews           SavedView[]
  workspaceInvitesSent WorkspaceInvite[]  @relation("WorkspaceInvitesSent")
  uploadRoutingPolicy  UploadRoutingPolicy?
  apiKeys              ApiKey[]
  sftpProfiles         SftpAccessProfile[]
  invitations          Invitation[]
  notificationPreferences NotificationPreference[]

  @@index([role])
  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  name       String    @db.VarChar(191)
  label      String?   @db.VarChar(191)
  keyPrefix  String    @map("key_prefix") @db.VarChar(32)
  keyHash    String    @unique @map("key_hash") @db.VarChar(255)
  scopes     String    @db.Text
  status     String    @default("active") @db.VarChar(32)
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("api_keys")
}

model UploadRoutingPolicy {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @unique @map("user_id") @db.Char(36)
  mode               String   @default("most_available") @db.VarChar(32)
  priorityAccountIds String   @map("priority_account_ids") @db.Text
  roundRobinCursor   Int      @default(0) @map("round_robin_cursor")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upload_routing_policies")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model AuthHandoff {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_handoffs")
}

model ProviderConfig {
  id                    String             @id @default(uuid()) @db.Char(36)
  userId                String?            @map("user_id") @db.Char(36)
  provider              String             @db.VarChar(32)
  clientIdEncrypted     String             @map("client_id_encrypted") @db.Text
  clientSecretEncrypted String             @map("client_secret_encrypted") @db.Text
  redirectUri           String             @map("redirect_uri") @db.Text
  scopes                String             @db.Text
  status                String             @default("active") @db.VarChar(32)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  user                  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  oauthStates           OauthState[]
  connectedAccounts     ConnectedAccount[]

  @@index([userId])
  @@index([provider])
  @@map("provider_configs")
}

model OauthState {
  id               String         @id @default(uuid()) @db.Char(36)
  userId           String?        @map("user_id") @db.Char(36)
  providerConfigId String         @map("provider_config_id") @db.Char(36)
  flow             String         @default("connect") @db.VarChar(32)
  stateHash        String         @unique @map("state_hash") @db.VarChar(255)
  expiresAt        DateTime       @map("expires_at")
  usedAt           DateTime?      @map("used_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_states")
}

model ConnectedAccount {
  id                    String           @id @default(uuid()) @db.Char(36)
  userId                String           @map("user_id") @db.Char(36)
  providerConfigId      String?          @map("provider_config_id") @db.Char(36)
  provider              String           @db.VarChar(32)
  providerAccountId     String           @map("provider_account_id") @db.VarChar(191)
  email                 String           @db.VarChar(191)
  displayName           String?          @map("display_name") @db.VarChar(191)
  avatarUrl             String?          @map("avatar_url") @db.Text
  accessTokenEncrypted  String?          @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?          @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime?        @map("token_expires_at")
  scopes                String           @db.Text
  status                String           @default("connected") @db.VarChar(32)
  enabled               Boolean          @default(true)
  revokedAt             DateTime?        @map("revoked_at")
  lastError             String?          @map("last_error") @db.Text
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig        ProviderConfig?  @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  storageAccount        StorageAccount?
  files                 File[]
  folders               Folder[]
  uploadSessions        UploadSession[]
  s3StorageConfig       S3StorageConfig?

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("connected_accounts")
}

model S3StorageConfig {
  id                       String           @id @default(uuid()) @db.Char(36)
  userId                   String           @map("user_id") @db.Char(36)
  connectedAccountId       String           @unique @map("connected_account_id") @db.Char(36)
  name                     String           @db.VarChar(191)
  bucket                   String           @db.VarChar(191)
  region                   String           @db.VarChar(191)
  endpoint                 String?          @db.Text
  accessKeyIdEncrypted     String           @map("access_key_id_encrypted") @db.Text
  secretAccessKeyEncrypted String           @map("secret_access_key_encrypted") @db.Text
  forcePathStyle           Boolean          @default(false) @map("force_path_style")
  prefix                   String           @default("better-drive") @db.VarChar(191)
  quotaBytes               BigInt?          @map("quota_bytes")
  status                   String           @default("active") @db.VarChar(32)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount         ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("s3_storage_configs")
}

model StorageAccount {
  id                 String           @id @default(uuid()) @db.Char(36)
  connectedAccountId String           @unique @map("connected_account_id") @db.Char(36)
  totalBytes         BigInt?          @map("total_bytes")
  usedBytes          BigInt           @default(0) @map("used_bytes")
  availableBytes     BigInt?          @map("available_bytes")
  trashBytes         BigInt?          @map("trash_bytes")
  lastSyncedAt       DateTime?        @map("last_synced_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("storage_accounts")
}

model File {
  id                 String             @id @default(uuid()) @db.Char(36)
  userId             String             @map("user_id") @db.Char(36)
  connectedAccountId String             @map("connected_account_id") @db.Char(36)
  folderId           String?            @map("folder_id") @db.Char(36)
  provider           String             @db.VarChar(32)
  providerFileId     String             @map("provider_file_id") @db.VarChar(191)
  name               String             @db.VarChar(255)
  mimeType           String             @map("mime_type") @db.VarChar(191)
  sizeBytes          BigInt             @map("size_bytes")
  checksum           String?            @db.VarChar(191)
  starred            Boolean            @default(false)
  starredAt          DateTime?          @map("starred_at")
  lastViewedAt       DateTime?          @map("last_viewed_at")
  status             String             @default("active") @db.VarChar(32)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount   @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  folder             Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares             FileShare[]
  previewTokens      FilePreviewToken[]

  @@index([userId])
  @@index([userId, status, createdAt])
  @@index([userId, status, folderId, createdAt])
  @@index([userId, status, starred, starredAt])
  @@index([userId, status, updatedAt])
  @@index([userId, checksum])
  @@index([connectedAccountId])
  @@index([folderId])
  @@index([providerFileId])
  @@map("files")
}

model FileShare {
  id             String    @id @default(uuid()) @db.Char(36)
  fileId         String    @map("file_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  tokenEncrypted String?   @map("token_encrypted") @db.Text
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  passwordHash   String?   @map("password_hash") @db.VarChar(255)
  enabled        Boolean   @default(true)
  downloadCount  Int       @default(0) @map("download_count")
  lastAccessedAt DateTime? @map("last_accessed_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  file           File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@index([userId, enabled, createdAt])
  @@index([fileId, userId, enabled, createdAt])
  @@map("file_shares")
}

model FilePreviewToken {
  id        String   @id @default(uuid()) @db.Char(36)
  fileId    String   @map("file_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@map("file_preview_tokens")
}

model Folder {
  id                 String            @id @default(uuid()) @db.Char(36)
  userId             String            @map("user_id") @db.Char(36)
  parentId           String?           @map("parent_id") @db.Char(36)
  connectedAccountId String?           @map("connected_account_id") @db.Char(36)
  provider           String            @default("google_drive") @db.VarChar(32)
  providerFolderId   String?           @map("provider_folder_id") @db.VarChar(191)
  name               String            @db.VarChar(255)
  color              String            @default("blue") @db.VarChar(64)
  iconUrl            String?           @map("icon_url") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent             Folder?           @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           Folder[]          @relation("FolderChildren")
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  files              File[]
  uploadSessions     UploadSession[]   @relation("UploadSessionFolder")

  @@index([userId])
  @@index([userId, deletedAt, updatedAt])
  @@index([userId, deletedAt, parentId, updatedAt])
  @@index([parentId])
  @@index([connectedAccountId])
  @@map("folders")
}

model SavedView {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  name      String   @db.VarChar(191)
  query     String   @db.Text
  icon      String?  @db.VarChar(64)
  pinned    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, pinned, sortOrder])
  @@map("saved_views")
}

model UploadSession {
  id                       String            @id @default(uuid()) @db.Char(36)
  userId                   String            @map("user_id") @db.Char(36)
  targetConnectedAccountId String?           @map("target_connected_account_id") @db.Char(36)
  folderId                 String?           @map("folder_id") @db.Char(36)
  fileName                 String            @map("file_name") @db.VarChar(255)
  mimeType                 String            @map("mime_type") @db.VarChar(191)
  sizeBytes                BigInt            @map("size_bytes")
  status                   String            @db.VarChar(32)
  googleSessionUri         String?           @map("google_session_uri") @db.Text
  errorMessage             String?           @map("error_message") @db.Text
  createdAt                DateTime          @default(now()) @map("created_at")
  completedAt              DateTime?         @map("completed_at")
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetConnectedAccount   ConnectedAccount? @relation(fields: [targetConnectedAccountId], references: [id], onDelete: SetNull)
  folder                   Folder?           @relation("UploadSessionFolder", fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@map("upload_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(191)
  entityType String   @map("entity_type") @db.VarChar(191)
  entityId   String?  @map("entity_id") @db.Char(36)
  metadata   String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model WorkspaceInvite {
  id           String    @id @default(uuid()) @db.Char(36)
  inviterId    String    @map("inviter_id") @db.Char(36)
  inviteeEmail String    @map("invitee_email") @db.VarChar(191)
  targetType   String    @default("file") @map("target_type") @db.VarChar(32)
  targetId     String    @default("") @map("target_id") @db.Char(36)
  role         String    @default("viewer") @db.VarChar(32)
  status       String    @default("pending") @db.VarChar(32)
  revokedAt    DateTime? @map("revoked_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  inviter      User      @relation("WorkspaceInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeEmail, targetType, targetId], map: "workspace_invites_target_unique")
  @@index([inviteeEmail])
  @@index([targetType, targetId])
  @@map("workspace_invites")
}

model SftpAccessProfile {
  id             String              @id @default(uuid()) @db.Char(36)
  userId         String              @map("user_id") @db.Char(36)
  label          String              @db.VarChar(191)
  allowRead      Boolean             @default(true) @map("allow_read")
  allowWrite     Boolean             @default(false) @map("allow_write")
  allowDelete    Boolean             @default(false) @map("allow_delete")
  allowedRoots   String              @map("allowed_roots") @db.Text
  maxUploadBytes BigInt?             @map("max_upload_bytes")
  ipAllowlist    String?             @map("ip_allowlist") @db.Text
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  keys           SftpAuthorizedKey[]

  @@index([userId])
  @@index([userId, enabled])
  @@map("sftp_access_profiles")
}

model SftpAuthorizedKey {
  id          String            @id @default(uuid()) @db.Char(36)
  profileId   String            @map("profile_id") @db.Char(36)
  label       String            @db.VarChar(191)
  publicKey   String            @map("public_key") @db.Text
  fingerprint String            @unique @db.VarChar(191)
  lastUsedAt  DateTime?         @map("last_used_at")
  revokedAt   DateTime?         @map("revoked_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  profile     SftpAccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessions    SftpSessionLog[]

  @@index([profileId])
  @@index([fingerprint])
  @@map("sftp_authorized_keys")
}

model SftpSessionLog {
  id        String             @id @default(uuid()) @db.Char(36)
  keyId     String?            @map("key_id") @db.Char(36)
  userId    String?            @map("user_id") @db.Char(36)
  remoteIp  String             @map("remote_ip") @db.VarChar(64)
  event     String             @db.VarChar(32)
  path      String?            @db.Text
  bytes     BigInt?
  outcome   String             @db.VarChar(32)
  createdAt DateTime           @default(now()) @map("created_at")
  key       SftpAuthorizedKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([keyId])
  @@index([userId])
  @@map("sftp_session_logs")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Char(36)
  email       String    @db.VarChar(191)
  role        String    @db.VarChar(32)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  invitedById String    @map("invited_by_id") @db.Char(36)
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([invitedById])
  @@map("invitations")
}

model NotificationPreference {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  eventType String   @map("event_type") @db.VarChar(64)
  channel   String   @default("in_app") @db.VarChar(32)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@index([userId])
  @@map("notification_preferences")
}

